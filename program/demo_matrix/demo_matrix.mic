; demo_matrix - zeigt die Zeichenbefehle der LED-Matrix (Protokoll v2, Firmware ab v1.4)
; 
;  Bedienung: Programm starten, "LED Start" in der Weboberflaeche, dann jede Taste
;  am 2090 zeigt die naechste Vorfuehrung. Beim Warten auf die Taste zeigt die Anzeige
;  deren Nummer (1-E); waehrend der Vorfuehrung ist sie aus (DISOUT, noetig fuers Timing).
;   1 ganze Matrix rot          2 Punkt                   3 Rechteck
;   4 Rahmen                    5 Ausschnitt ausblenden   6 wieder einblenden
;   7 Linienzug                 8 Schieben mit Umlauf     9 Schlafen (ACK 15)
;   A Glitter                   B bunte Vielecke          C Rahmen ineinander, Farben laufen
;   D Regenbogen schieben       E Feuerwerk
;  Danach beginnt es von vorn.
; 
;  Unterprogramme nur mit Tiefe 1 (der 2090 merkt sich nur EINE Ruecksprungadresse):
;  kein CALL in einem Unterprogramm, weiter nur mit GOTO.
; 
;  Cursor 1 wird vor Figuren stumm gesetzt (Art 0), die Figur erscheint erst mit Cursor 2.
; 
;  Register: r0 REQ/Null, r1 ACK, r2 x bzw. Wert, r3 y, r4 Taste, r5 Nummer,
;            r6-r8 und rC Zaehler, r9/rA Startpunkt, rB Ecken, rD-rF Zufall (RND)
;
F08 ; 00 start:         CLEAR
BA5 ; 01                CALL taste
112 ; 02                MOVI #1,X           Farbe 1 = rot
BBB ; 03                CALL farbe
112 ; 04                MOVI #1,X           Art 1: Farbe + Bits
BBD ; 05                CALL ganz
BA5 ; 06                CALL taste
BA9 ; 07                CALL loeschen
132 ; 08                MOVI #3,X           gelb
BBB ; 09                CALL farbe
1B2 ; 0A                MOVI #B,X           x = 3 +8 (sichtbar)
143 ; 0B                MOVI #4,Y           y = 4
BBF ; 0C                CALL punkt
BA5 ; 0D                CALL taste
142 ; 0E                MOVI #4,X           gruen
BBB ; 0F                CALL farbe
112 ; 10                MOVI #1,X           Cursor 1 = (1,1), stumm (Art 0: nur Farbebene)
113 ; 11                MOVI #1,Y
BBF ; 12                CALL punkt
1E2 ; 13                MOVI #E,X           Cursor 2 = (6,5)
153 ; 14                MOVI #5,Y
BC1 ; 15                CALL rechteck
BA5 ; 16                CALL taste
162 ; 17                MOVI #6,X           blau
BBB ; 18                CALL farbe
102 ; 19                MOVI #0,X           Cursor 1 = (0,0), stumm
103 ; 1A                MOVI #0,Y
BBF ; 1B                CALL punkt
1F2 ; 1C                MOVI #F,X           (7,7)
173 ; 1D                MOVI #7,Y
BC3 ; 1E                CALL rahmen
BA5 ; 1F                CALL taste
1A2 ; 20                MOVI #A,X           (2,2), x+8 und y+8 = Art 3
1A3 ; 21                MOVI #A,Y
BBF ; 22                CALL punkt
1D2 ; 23                MOVI #D,X           (5,5)
1D3 ; 24                MOVI #D,Y
BC1 ; 25                CALL rechteck
BA5 ; 26                CALL taste
122 ; 27                MOVI #2,X           (2,2), nur y+8 = Art 2
1A3 ; 28                MOVI #A,Y
BBF ; 29                CALL punkt
152 ; 2A                MOVI #5,X           (5,5)
1D3 ; 2B                MOVI #D,Y
BC1 ; 2C                CALL rechteck
BA5 ; 2D                CALL taste
BA9 ; 2E                CALL loeschen
182 ; 2F                MOVI #8,X           magenta
BBB ; 30                CALL farbe
102 ; 31                MOVI #0,X           Start (0,7), stumm
173 ; 32                MOVI #7,Y
BBF ; 33                CALL punkt
1F2 ; 34                MOVI #F,X           -> (7,7)
BC5 ; 35                CALL linie
182 ; 36                MOVI #8,X           -> (0,0), schraeg
103 ; 37                MOVI #0,Y
BC5 ; 38                CALL linie
1F2 ; 39                MOVI #F,X           -> (7,0)
BC5 ; 3A                CALL linie
BA5 ; 3B                CALL taste
192 ; 3C                MOVI #9,X           rechts + Umlauf
176 ; 3D                MOVI #7,I           8 Mal
BC7 ; 3E s_rechts:      CALL schieben
5F6 ; 3F                ADDI #F,I           I-1, Carry solange I >= 1 war
D3E ; 40                BRC s_rechts
1A2 ; 41                MOVI #A,X           hoch + Umlauf
176 ; 42                MOVI #7,I
BC7 ; 43 s_hoch:        CALL schieben
5F6 ; 44                ADDI #F,I
D43 ; 45                BRC s_hoch
BA5 ; 46                CALL taste
1F2 ; 47                MOVI #F,X           Nibble nach dem ACK = F: kein Wechsel auf F, weckt nicht
BC9 ; 48                CALL schlafen
BA5 ; 49                CALL taste          Taste fuer A, die Matrix schlaeft
FE2 ; 4A                DOT X               F anlegen und halten: aufwecken
FD0 ; 4B wach:          DIN REQ             bis der ESP mit REQ antwortet (egal, wie spaet er nachsieht)
310 ; 4C                ANDI #1,REQ
E4B ; 4D                BRZ wach
100 ; 4E                MOVI #0,REQ
FE0 ; 4F                DOT REQ             erst 0, dann das naechste ACK: der ESP bleibt wach
BA9 ; 50                CALL loeschen
137 ; 51                MOVI #3,J           4 x 16 = 64 Funken
1F6 ; 52 gl_aussen:     MOVI #F,I
BB0 ; 53 gl_innen:      CALL zfarbe         zufaellige Farbe 0-7 (0 = schwarz loescht den Funken)
BB4 ; 54                CALL zpos           zufaelliger Punkt, sichtbar
BBF ; 55                CALL punkt
5F6 ; 56                ADDI #F,I
D53 ; 57                BRC gl_innen
5F7 ; 58                ADDI #F,J
D52 ; 59                BRC gl_aussen
BA5 ; 5A                CALL taste
BA9 ; 5B                CALL loeschen
197 ; 5C                MOVI #9,J           10 Vierecke
BAB ; 5D vieleck:       CALL zbunt
BB4 ; 5E                CALL zpos           erste Ecke (x+8)
029 ; 5F                MOV X,PX            merken, mit +8 fuer die letzte Linie
03A ; 60                MOV Y,PY
372 ; 61                ANDI #7,X           Cursor 1 stumm
BBF ; 62                CALL punkt
12B ; 63                MOVI #2,ECKE        3 weitere Ecken
BB4 ; 64 ecke:          CALL zpos
BC5 ; 65                CALL linie
5FB ; 66                ADDI #F,ECKE
D64 ; 67                BRC ecke
092 ; 68                MOV PX,X            zurueck zur ersten Ecke
0A3 ; 69                MOV PY,Y
BC5 ; 6A                CALL linie
5F7 ; 6B                ADDI #F,J
D5D ; 6C                BRC vieleck
BA5 ; 6D                CALL taste
11C ; 6E                MOVI #1,RUNDE       2 Runden
158 ; 6F r_runde:       MOVI #5,K           je 6 Bilder, Farben 6...9 bis 1...4
106 ; 70 r_bild:        MOVI #0,I           Ring 0 ... 3
087 ; 71                MOV K,J
517 ; 72 r_ring:        ADDI #1,J           Farbe = K + Ring + 1
072 ; 73                MOV J,X
BBB ; 74                CALL farbe
062 ; 75                MOV I,X             Cursor 1 = (i,i), stumm
063 ; 76                MOV I,Y
BBF ; 77                CALL punkt
1F2 ; 78                MOVI #F,X           Cursor 2 = (7-i,7-i), x+8
662 ; 79                SUB I,X
173 ; 7A                MOVI #7,Y
663 ; 7B                SUB I,Y
BC3 ; 7C                CALL rahmen
516 ; 7D                ADDI #1,I
946 ; 7E                CMPI #4,I
E81 ; 7F                BRZ r_weiter
C72 ; 80                GOTO r_ring
5F8 ; 81 r_weiter:      ADDI #F,K
D70 ; 82                BRC r_bild
5FC ; 83                ADDI #F,RUNDE
D6F ; 84                BRC r_runde
BA5 ; 85                CALL taste
106 ; 86                MOVI #0,I           Spalte 0 ... 7
062 ; 87 rb_spalte:     MOV I,X             Farbe = Spalte + 1
512 ; 88                ADDI #1,X
BBB ; 89                CALL farbe
062 ; 8A                MOV I,X             Cursor 1 = (i,0), stumm
103 ; 8B                MOVI #0,Y
BBF ; 8C                CALL punkt
582 ; 8D                ADDI #8,X           Linie bis (i,7), sichtbar
173 ; 8E                MOVI #7,Y
BC5 ; 8F                CALL linie
516 ; 90                ADDI #1,I
986 ; 91                CMPI #8,I
E94 ; 92                BRZ rb_laufen
C87 ; 93                GOTO rb_spalte
182 ; 94 rb_laufen:     MOVI #8,X           links + Umlauf
1F6 ; 95                MOVI #F,I           16 Mal
BC7 ; 96 rb_schritt:    CALL schieben
5F6 ; 97                ADDI #F,I
D96 ; 98                BRC rb_schritt
BA5 ; 99                CALL taste
BA9 ; 9A                CALL loeschen
1F6 ; 9B                MOVI #F,I           16 Strahlen
BAB ; 9C strahl:        CALL zbunt
132 ; 9D                MOVI #3,X           Mitte (3,3), stumm
133 ; 9E                MOVI #3,Y
BBF ; 9F                CALL punkt
BB4 ; A0                CALL zpos
BC5 ; A1                CALL linie
5F6 ; A2                ADDI #F,I
D9C ; A3                BRC strahl
C00 ; A4                GOTO start
515 ; A5 taste:         ADDI #1,NR
F15 ; A6                DISP #1,NR
FF4 ; A7                KIN TASTE
F07 ; A8                RET
132 ; A9 loeschen:      MOVI #3,X
CBD ; AA                GOTO ganz
F05 ; AB zbunt:         RND
0F2 ; AC                MOV ZF,X
372 ; AD                ANDI #7,X
512 ; AE                ADDI #1,X
CBB ; AF                GOTO farbe
F05 ; B0 zfarbe:        RND
0F2 ; B1                MOV ZF,X
372 ; B2                ANDI #7,X
CBB ; B3                GOTO farbe
F05 ; B4 zpos:          RND
0D2 ; B5                MOV ZX,X
372 ; B6                ANDI #7,X
582 ; B7                ADDI #8,X
0E3 ; B8                MOV ZY,Y
373 ; B9                ANDI #7,Y
F07 ; BA                RET
1E1 ; BB farbe:         MOVI #E,FUNC        ACK 14 aktive Farbe (1 Nibble)
CCA ; BC                GOTO cmd
131 ; BD ganz:          MOVI #3,FUNC        ACK 3 ganze Matrix (1 Nibble)
CCA ; BE                GOTO cmd
141 ; BF punkt:         MOVI #4,FUNC        ACK 4 Cursor 1 / Punkt
CCA ; C0                GOTO cmd
161 ; C1 rechteck:      MOVI #6,FUNC        ACK 6 Rechteck gefuellt
CCA ; C2                GOTO cmd
171 ; C3 rahmen:        MOVI #7,FUNC        ACK 7 Rahmen
CCA ; C4                GOTO cmd
181 ; C5 linie:         MOVI #8,FUNC        ACK 8 Linie, Cursor 1 folgt
CCA ; C6                GOTO cmd
1B1 ; C7 schieben:      MOVI #B,FUNC        ACK 11 schieben (1 Nibble)
CCA ; C8                GOTO cmd
1F1 ; C9 schlafen:      MOVI #F,FUNC        ACK 15 schlafen (ohne Nibble)
F02 ; CA cmd:           DISOUT              Anzeige aus: sonst stimmt die Befehlsdauer nicht
FD0 ; CB warte:         DIN REQ             warten auf REQ
310 ; CC                ANDI #1,REQ
ECB ; CD                BRZ warte
FE1 ; CE                DOT FUNC            ACK
FE2 ; CF                DOT X               Nibble 1
FE3 ; D0                DOT Y               Nibble 2 (bei 1 Nibble ohne Bedeutung)
100 ; D1                MOVI #0,REQ
FE0 ; D2                DOT REQ             Ausgaenge auf 0
F07 ; D3                RET
