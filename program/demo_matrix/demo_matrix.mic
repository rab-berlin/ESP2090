; demo_matrix - zeigt die Zeichenbefehle der LED-Matrix (Protokoll v2, Firmware ab v1.4)
;  Quelle: beispiele/demo_matrix.src, erzeugt mit: python tools/micasm.py beispiele/demo_matrix.src beispiele/demo_matrix.mic
; 
;  Bedienung: Programm starten, "LED Start" in der Weboberflaeche, dann jede Taste
;  am 2090 zeigt die naechste Vorfuehrung. Beim Warten auf die Taste zeigt die Anzeige
;  deren Nummer (1-E); waehrend der Vorfuehrung ist sie aus (DISOUT, noetig fuers Timing).
;   1 ganze Matrix rot          2 Punkt                   3 Rechteck
;   4 Rahmen                    5 Ausschnitt ausblenden   6 wieder einblenden
;   7 Linienzug                 8 Schieben mit Umlauf     9 Schlafen (ACK 15)
;   A Glitter                   B bunte Vielecke          C Rahmen ineinander, Farben laufen
;   D Regenbogen schieben       E Feuerwerk
;  Danach beginnt es von vorn.
; 
;  Unterprogramme nur mit Tiefe 1 (der 2090 merkt sich nur EINE Ruecksprungadresse):
;  kein CALL in einem Unterprogramm, weiter nur mit GOTO.
; 
;  Cursor 1 wird vor Figuren stumm gesetzt (Art 0), die Figur erscheint erst mit Cursor 2.
; 
;  Register: r0 REQ/Null, r1 ACK, r2 x bzw. Wert, r3 y, r4 Taste, r5 Nummer,
;            r6-r8 und rC Zaehler, r9/rA Startpunkt, rB Ecken, rD-rF Zufall (RND)
;
F08 ; 00 start:         CLEAR
BA1 ; 01                CALL taste
112 ; 02                MOVI #1,X           Farbe 1 = rot
BB7 ; 03                CALL farbe
112 ; 04                MOVI #1,X           Art 1: Farbe + Bits
BB9 ; 05                CALL ganz
BA1 ; 06                CALL taste
BA5 ; 07                CALL loeschen
132 ; 08                MOVI #3,X           gelb
BB7 ; 09                CALL farbe
1B2 ; 0A                MOVI #B,X           x = 3 +8 (sichtbar)
143 ; 0B                MOVI #4,Y           y = 4
BBB ; 0C                CALL punkt
BA1 ; 0D                CALL taste
142 ; 0E                MOVI #4,X           gruen
BB7 ; 0F                CALL farbe
112 ; 10                MOVI #1,X           Cursor 1 = (1,1), stumm (Art 0: nur Farbebene)
113 ; 11                MOVI #1,Y
BBB ; 12                CALL punkt
1E2 ; 13                MOVI #E,X           Cursor 2 = (6,5)
153 ; 14                MOVI #5,Y
BBD ; 15                CALL rechteck
BA1 ; 16                CALL taste
162 ; 17                MOVI #6,X           blau
BB7 ; 18                CALL farbe
102 ; 19                MOVI #0,X           Cursor 1 = (0,0), stumm
103 ; 1A                MOVI #0,Y
BBB ; 1B                CALL punkt
1F2 ; 1C                MOVI #F,X           (7,7)
173 ; 1D                MOVI #7,Y
BBF ; 1E                CALL rahmen
BA1 ; 1F                CALL taste
1A2 ; 20                MOVI #A,X           (2,2), x+8 und y+8 = Art 3
1A3 ; 21                MOVI #A,Y
BBB ; 22                CALL punkt
1D2 ; 23                MOVI #D,X           (5,5)
1D3 ; 24                MOVI #D,Y
BBD ; 25                CALL rechteck
BA1 ; 26                CALL taste
122 ; 27                MOVI #2,X           (2,2), nur y+8 = Art 2
1A3 ; 28                MOVI #A,Y
BBB ; 29                CALL punkt
152 ; 2A                MOVI #5,X           (5,5)
1D3 ; 2B                MOVI #D,Y
BBD ; 2C                CALL rechteck
BA1 ; 2D                CALL taste
BA5 ; 2E                CALL loeschen
182 ; 2F                MOVI #8,X           magenta
BB7 ; 30                CALL farbe
102 ; 31                MOVI #0,X           Start (0,7), stumm
173 ; 32                MOVI #7,Y
BBB ; 33                CALL punkt
1F2 ; 34                MOVI #F,X           -> (7,7)
BC1 ; 35                CALL linie
182 ; 36                MOVI #8,X           -> (0,0), schraeg
103 ; 37                MOVI #0,Y
BC1 ; 38                CALL linie
1F2 ; 39                MOVI #F,X           -> (7,0)
BC1 ; 3A                CALL linie
BA1 ; 3B                CALL taste
192 ; 3C                MOVI #9,X           rechts + Umlauf
176 ; 3D                MOVI #7,I           8 Mal
BC3 ; 3E s_rechts:      CALL schieben
5F6 ; 3F                ADDI #F,I           I-1, Carry solange I >= 1 war
D3E ; 40                BRC s_rechts
1A2 ; 41                MOVI #A,X           hoch + Umlauf
176 ; 42                MOVI #7,I
BC3 ; 43 s_hoch:        CALL schieben
5F6 ; 44                ADDI #F,I
D43 ; 45                BRC s_hoch
BA1 ; 46                CALL taste
1F2 ; 47                MOVI #F,X           Nibble nach dem ACK = F: kein Wechsel auf F, weckt nicht
BC5 ; 48                CALL schlafen
BA1 ; 49                CALL taste          Taste fuer A, die Matrix schlaeft
FE2 ; 4A                DOT X               F nach der 0 von cmd: aufwachen
FE0 ; 4B                DOT REQ             Ausgaenge auf 0 (REQ ist nach cmd 0), dann gilt das naechste ACK
BA5 ; 4C                CALL loeschen
137 ; 4D                MOVI #3,J           4 x 16 = 64 Funken
1F6 ; 4E gl_aussen:     MOVI #F,I
BAC ; 4F gl_innen:      CALL zfarbe         zufaellige Farbe 0-7 (0 = schwarz loescht den Funken)
BB0 ; 50                CALL zpos           zufaelliger Punkt, sichtbar
BBB ; 51                CALL punkt
5F6 ; 52                ADDI #F,I
D4F ; 53                BRC gl_innen
5F7 ; 54                ADDI #F,J
D4E ; 55                BRC gl_aussen
BA1 ; 56                CALL taste
BA5 ; 57                CALL loeschen
197 ; 58                MOVI #9,J           10 Vierecke
BA7 ; 59 vieleck:       CALL zbunt
BB0 ; 5A                CALL zpos           erste Ecke (x+8)
029 ; 5B                MOV X,PX            merken, mit +8 fuer die letzte Linie
03A ; 5C                MOV Y,PY
372 ; 5D                ANDI #7,X           Cursor 1 stumm
BBB ; 5E                CALL punkt
12B ; 5F                MOVI #2,ECKE        3 weitere Ecken
BB0 ; 60 ecke:          CALL zpos
BC1 ; 61                CALL linie
5FB ; 62                ADDI #F,ECKE
D60 ; 63                BRC ecke
092 ; 64                MOV PX,X            zurueck zur ersten Ecke
0A3 ; 65                MOV PY,Y
BC1 ; 66                CALL linie
5F7 ; 67                ADDI #F,J
D59 ; 68                BRC vieleck
BA1 ; 69                CALL taste
11C ; 6A                MOVI #1,RUNDE       2 Runden
158 ; 6B r_runde:       MOVI #5,K           je 6 Bilder, Farben 6...9 bis 1...4
106 ; 6C r_bild:        MOVI #0,I           Ring 0 ... 3
087 ; 6D                MOV K,J
517 ; 6E r_ring:        ADDI #1,J           Farbe = K + Ring + 1
072 ; 6F                MOV J,X
BB7 ; 70                CALL farbe
062 ; 71                MOV I,X             Cursor 1 = (i,i), stumm
063 ; 72                MOV I,Y
BBB ; 73                CALL punkt
1F2 ; 74                MOVI #F,X           Cursor 2 = (7-i,7-i), x+8
662 ; 75                SUB I,X
173 ; 76                MOVI #7,Y
663 ; 77                SUB I,Y
BBF ; 78                CALL rahmen
516 ; 79                ADDI #1,I
946 ; 7A                CMPI #4,I
E7D ; 7B                BRZ r_weiter
C6E ; 7C                GOTO r_ring
5F8 ; 7D r_weiter:      ADDI #F,K
D6C ; 7E                BRC r_bild
5FC ; 7F                ADDI #F,RUNDE
D6B ; 80                BRC r_runde
BA1 ; 81                CALL taste
106 ; 82                MOVI #0,I           Spalte 0 ... 7
062 ; 83 rb_spalte:     MOV I,X             Farbe = Spalte + 1
512 ; 84                ADDI #1,X
BB7 ; 85                CALL farbe
062 ; 86                MOV I,X             Cursor 1 = (i,0), stumm
103 ; 87                MOVI #0,Y
BBB ; 88                CALL punkt
582 ; 89                ADDI #8,X           Linie bis (i,7), sichtbar
173 ; 8A                MOVI #7,Y
BC1 ; 8B                CALL linie
516 ; 8C                ADDI #1,I
986 ; 8D                CMPI #8,I
E90 ; 8E                BRZ rb_laufen
C83 ; 8F                GOTO rb_spalte
182 ; 90 rb_laufen:     MOVI #8,X           links + Umlauf
1F6 ; 91                MOVI #F,I           16 Mal
BC3 ; 92 rb_schritt:    CALL schieben
5F6 ; 93                ADDI #F,I
D92 ; 94                BRC rb_schritt
BA1 ; 95                CALL taste
BA5 ; 96                CALL loeschen
1F6 ; 97                MOVI #F,I           16 Strahlen
BA7 ; 98 strahl:        CALL zbunt
132 ; 99                MOVI #3,X           Mitte (3,3), stumm
133 ; 9A                MOVI #3,Y
BBB ; 9B                CALL punkt
BB0 ; 9C                CALL zpos
BC1 ; 9D                CALL linie
5F6 ; 9E                ADDI #F,I
D98 ; 9F                BRC strahl
C00 ; A0                GOTO start
515 ; A1 taste:         ADDI #1,NR
F15 ; A2                DISP #1,NR
FF4 ; A3                KIN TASTE
F07 ; A4                RET
132 ; A5 loeschen:      MOVI #3,X
CB9 ; A6                GOTO ganz
F05 ; A7 zbunt:         RND
0F2 ; A8                MOV ZF,X
372 ; A9                ANDI #7,X
512 ; AA                ADDI #1,X
CB7 ; AB                GOTO farbe
F05 ; AC zfarbe:        RND
0F2 ; AD                MOV ZF,X
372 ; AE                ANDI #7,X
CB7 ; AF                GOTO farbe
F05 ; B0 zpos:          RND
0D2 ; B1                MOV ZX,X
372 ; B2                ANDI #7,X
582 ; B3                ADDI #8,X
0E3 ; B4                MOV ZY,Y
373 ; B5                ANDI #7,Y
F07 ; B6                RET
1E1 ; B7 farbe:         MOVI #E,FUNC        ACK 14 aktive Farbe (1 Nibble)
CC6 ; B8                GOTO cmd
131 ; B9 ganz:          MOVI #3,FUNC        ACK 3 ganze Matrix (1 Nibble)
CC6 ; BA                GOTO cmd
141 ; BB punkt:         MOVI #4,FUNC        ACK 4 Cursor 1 / Punkt
CC6 ; BC                GOTO cmd
161 ; BD rechteck:      MOVI #6,FUNC        ACK 6 Rechteck gefuellt
CC6 ; BE                GOTO cmd
171 ; BF rahmen:        MOVI #7,FUNC        ACK 7 Rahmen
CC6 ; C0                GOTO cmd
181 ; C1 linie:         MOVI #8,FUNC        ACK 8 Linie, Cursor 1 folgt
CC6 ; C2                GOTO cmd
1B1 ; C3 schieben:      MOVI #B,FUNC        ACK 11 schieben (1 Nibble)
CC6 ; C4                GOTO cmd
1F1 ; C5 schlafen:      MOVI #F,FUNC        ACK 15 schlafen (ohne Nibble)
F02 ; C6 cmd:           DISOUT              Anzeige aus: sonst stimmt die Befehlsdauer nicht
FD0 ; C7 warte:         DIN REQ             warten auf REQ
310 ; C8                ANDI #1,REQ
EC7 ; C9                BRZ warte
FE1 ; CA                DOT FUNC            ACK
FE2 ; CB                DOT X               Nibble 1
FE3 ; CC                DOT Y               Nibble 2 (bei 1 Nibble ohne Bedeutung)
100 ; CD                MOVI #0,REQ
FE0 ; CE                DOT REQ             Ausgaenge auf 0
F07 ; CF                RET
