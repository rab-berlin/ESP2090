141 ; E2 punkt:       R1 = 4: Cursor 1 / Punkt
CEF ; E3
161 ; E4 rechteck:    R1 = 6: Rechteck Cursor 1 - Cursor 2
CEF ; E5
131 ; E6 ganz:        R1 = 3: ganze Matrix, R2 = 0 (nach cmd immer): nur Farbmatrix
CEF ; E7
532 ; E8 f_magenta:   R2 += 3   (R2 ist hier immer 0)
512 ; E9 f_tuerkis:   R2 += 1
512 ; EA f_gruen:
512 ; EB f_gelb:
512 ; EC f_orange:
512 ; ED f_rot:       R2 += 1   -> magenta 8, tuerkis 5, gruen 4, gelb 3, orange 2, rot 1
1E1 ; EE farbe:       R1 = 14: aktive Farbe
FD0 ; EF cmd:         DIN R0     warten auf REQ
310 ; F0              ANDI 1,R0
EEF ; F1              BRZ
FE1 ; F2              DOT R1     ACK
FE2 ; F3              DOT R2     Nibble 1 (x bzw. Wert)
FE3 ; F4              DOT R3     Nibble 2 (y; bei Befehlen mit 1 Nibble ohne Bedeutung)
102 ; F5              R2 = 0
FE2 ; F6              Ausgaenge auf 0
F07 ; F7              RET
