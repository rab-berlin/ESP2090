B{bild}

B{f_rot}
B{ganz}
C{loop}

; ---------- Bild senden: ACK 1, EXRL, 16 Nibbles ----------
bild:
FD0                 ; DIN R0     warten auf REQ
310                 ; ANDI 1,R0
E{bild}             ; BRZ
FE0                 ; DOT R0     ACK 1
F0D                 ; EXRL       (der eine Befehl vor den Daten)
FE0                 ; Nibble 0
FE1
FE2
FE3
FE4
FE5
FE6
FE7
FE8
FE9
FEA
FEB
FEC
FED
FEE
FEF                 ; Nibble 15
F0D                 ; EXRL
FE2                 ; Ausgaenge auf 0 (R2 ist beim Aufruf immer 0, siehe cmd)
F07                 ; RET

; ---------- Befehle mit Daten in R2 (und R3) ----------
punkt:
141                 ; R1 = 4: Cursor 1 / Punkt
C{cmd}
rechteck:
161                 ; R1 = 6: Rechteck Cursor 1 - Cursor 2
C{cmd}
ganz:
131                 ; R1 = 3: ganze Matrix, R2 = 0 (nach cmd immer): nur Farbebene
C{cmd}
f_magenta:
532                 ; R2 += 3   (R2 ist hier immer 0)
f_tuerkis:
512                 ; R2 += 1
f_gruen:
512
f_gelb:
512
f_orange:
512
f_rot:
512                 ; R2 += 1   -> magenta 8, tuerkis 5, gruen 4, gelb 3, orange 2, rot 1
farbe:
1E1                 ; R1 = 14: aktive Farbe
cmd:
FD0                 ; DIN R0     warten auf REQ
310                 ; ANDI 1,R0
E{cmd}              ; BRZ
FE1                 ; DOT R1     ACK
FE2                 ; DOT R2     Nibble 1 (x bzw. Wert)
FE3                 ; DOT R3     Nibble 2 (y; bei Befehlen mit 1 Nibble ohne Bedeutung)
102                 ; R2 = 0
FE2                 ; Ausgaenge auf 0
F07                 ; RET

; ---------- Blinkbilder ----------
blink_a:
10B
16D
16F
C{bild}
blink_b:
16B
1FD
1FF
C{bild}
