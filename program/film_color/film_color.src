; ---------- Szene 2 ----------
B{blink_a}
B{blink_b}
B{blink_a}
B{blink_b}
B{blink_a}

; Rechteck gruen (4,0)-(7,4)
B{f_gruen}
142                 ; x = 4
103                 ; y = 0
B{punkt}
172                 ; x = 7
143                 ; y = 4
