;; film_color - ein "Film" mit farbigen Pixeln auf der 8x8-Matrix
;; Fassung fuer Matrix-Protokoll v2 (main.py ab v1.4)
;; Quelltext mit Sprungmarken und Mnemonics: film_color.src
;;
;; Unterprogramme nur mit Tiefe 1: der 2090 merkt sich nur EINE Ruecksprungadresse,
;; deshalb ruft kein Unterprogramm ein anderes mit CALL auf (nur GOTO als Tail-Call).
;;
;; Register: R0 Warten auf REQ / Null, R1 ACK-Code, R2 x bzw. Datennibble, R3 y
;; Bild: Nibble 0-7 in der Ablage 0-7, Nibble 8-15 in R8-RF
;; Befehle: ACK 4 (x,y) Cursor 1/Punkt, ACK 6 (x,y) Rechteck, ACK 14 Farbe, ACK 3 ganze Matrix
;; Zeichenart ohne +8: nur Farbebene (sichtbar mit dem naechsten Bild), wie im alten Film

; ---------- Start ----------
start:
F02                 ; DISOUT  Anzeige aus
loop:
F08                 ; CLEAR
F0D                 ; EXRL
F08                 ; CLEAR   R0-RF und Ablage 0-7 geloescht (Ablage 8-F wird nicht benutzt, kein EXRM noetig)
1F0                 ; Startbild: Ablage 0,2,4,6 = F
1F2
1F4
1F6
F0D                 ; EXRL
168                 ; R8 = 6

; ---------- Szene 1: Blinken ----------
B{blink_a}
B{blink_b}
B{blink_a}
B{blink_b}
B{blink_a}

; Rechteck tuerkis (4,5)-(7,7)
B{f_tuerkis}
142                 ; x = 4
153                 ; y = 5
B{punkt}            ; Cursor 1
172                 ; x = 7
173                 ; y = 7
B{rechteck}
; Rechteck gelb (5,6)-(6,7)
B{f_gelb}
152                 ; x = 5
163                 ; y = 6
B{punkt}
162                 ; x = 6
173                 ; y = 7
B{rechteck}

